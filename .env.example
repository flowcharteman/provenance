# Copy to .env and set a local-only PostgreSQL password before starting Compose.
POSTGRES_DB=investment_analysis
POSTGRES_USER=investment_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379

# Required before making SEC requests. Configure an identifying product/team
# name and a monitored contact email; neither value is supplied by this project.
SEC_USER_AGENT_NAME=
SEC_CONTACT_EMAIL=

# SEC fair-access request scheduling/retry settings.
SEC_REQUESTS_PER_SECOND=8
SEC_MAX_RETRIES=4
SEC_INITIAL_BACKOFF_SECONDS=1
SEC_MAX_BACKOFF_SECONDS=30
SEC_REQUEST_TIMEOUT_SECONDS=20
SEC_HTTP_CACHE_DIR=
